---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { publishedProjects } from '../../lib/projects';
export async function getStaticPaths() { return (await publishedProjects()).map(project => ({ params: { slug: project.data.slug }, props: { project } })); }
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);
---
<Layout title={p.title} description={p.summary} image={p.cover.src}><article class="wrap project-detail"><a class="text-link" href="/work/">← All work</a><header class="page-heading"><span class="eyebrow">{p.category}</span><h1>{p.title}</h1><p>{p.summary}</p><div class="project-meta">{p.role && <span>Role: {p.role}</span>}{p.year && <span>{p.year}</span>}</div></header>
<figure class:list={['detail-visual', p.coverStyle]}><Image src={p.cover} alt={p.coverAlt} widths={[600,1000,1600]} sizes="(min-width: 1200px) 1120px, 90vw" format="webp" loading="eager" /></figure>
<div class="project-story"><span class="eyebrow">Project overview</span><div class="prose"><Content /></div><div class="hero-actions">{p.behance && <a class="button" href={p.behance} target="_blank" rel="noopener noreferrer">View on Behance ↗<span class="sr-only">, opens in a new tab</span></a>}{p.website && <a class="text-link" href={p.website} target="_blank" rel="noopener noreferrer">Project link ↗<span class="sr-only">, opens in a new tab</span></a>}</div></div></article></Layout>
